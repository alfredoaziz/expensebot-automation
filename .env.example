# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

# --- Ollama (local vision LLM, runs as its own Docker service) ---
# Reached over the internal Docker network — no host/port setup needed.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:4b
# Nama persis seperti tertulis di rekening/e-wallet-mu — dipakai untuk
# membedakan Pemasukan/Pengeluaran pada bukti transfer ("Rekening Sumber"
# vs "Nama Penerima"). Boleh dikosongkan.
ACCOUNT_HOLDER_NAME=Your Full Name

# --- Google (Sheets + Drive) ---
GOOGLE_CREDENTIALS_DIR=/app/credentials
# Just the ID segment from the URL, e.g. https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_example
# Just the ID segment from https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_example

# --- V2: catat otomatis dari email notifikasi mobile banking (Gmail) ---
# Butuh Gmail API aktif + jalankan ulang scripts/authorize_google.py (izin baca Gmail).
GMAIL_ENABLED=true
# Query pencarian Gmail. newer_than: membatasi seberapa jauh ke belakang bot melihat.
GMAIL_QUERY=from:(bankbsi.co.id OR blubybcadigital.id) newer_than:1d
GMAIL_POLL_INTERVAL_SECONDS=60
# true = transfer antar rekening sendiri (mis. BSI -> blu) tetap dicatat
# sebagai pengeluaran + pemasukan. Default false: hanya dilaporkan, tidak dicatat.
GMAIL_CATAT_TRANSFER_SENDIRI=false

# --- General ---
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
